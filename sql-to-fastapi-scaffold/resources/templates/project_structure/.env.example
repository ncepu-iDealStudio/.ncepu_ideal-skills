APP_NAME={{project_name}}
APP_VERSION=1.0.0
APP_DESCRIPTION={{project_description}}
DEBUG=true
HOST=0.0.0.0
PORT=8000

DATABASE_URL=mysql+pymysql://user:password@localhost:3306/{{project_name}}

SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

CORS_ORIGINS=["*"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]

LOG_LEVEL=INFO
LOG_FILE=logs/app.log
