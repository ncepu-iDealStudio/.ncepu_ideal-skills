APP_NAME=study_flask_api
APP_VERSION=1.0.0
APP_DESCRIPTION=学生课程管理系统
DEBUG=true
HOST=0.0.0.0
PORT=8000

DATABASE_URL=mysql+pymysql://user:password@localhost:3306/study_flask_api

SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

CORS_ORIGINS=["*"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]

LOG_LEVEL=INFO
LOG_FILE=logs/app.log