<template>
  <view class="page">
    <view v-if="loading" class="page__loading">
      <text class="page__loading-text">加载中…</text>
    </view>

    <EmptyState v-else-if="!detail" text="内容不存在或已下架" />

    <scroll-view v-else class="page__body" scroll-y>
      <!-- 主图 -->
      <image
        v-if="detail.avatar"
        class="hero"
        :src="detail.avatar"
        mode="aspectFill"
      />

      <view class="content">
        <!-- 标题区 -->
        <text class="content__title">{{ detail.title }}</text>
        <view class="content__meta">
          <text class="content__meta-text">{{ detail.userName }}</text>
          <text class="content__meta-text">评分 {{ formatRating(detail.rating) }}</text>
          <text class="content__meta-text">已换 {{ formatNumber(detail.swapCount) }} 次</text>
        </view>

        <!-- 标签 -->
        <view class="content__tags">
          <text v-for="tag in detail.tags" :key="tag" class="tag">{{ tag }}</text>
        </view>

        <!-- 正文 -->
        <view class="content__section">
          <text class="content__section-title">详细介绍</text>
          <text class="content__text">{{ detail.description }}</text>
        </view>

        <!-- 想学 -->
        <view v-if="detail.wantTags.length > 0" class="content__section">
          <text class="content__section-title">我想学</text>
          <view class="content__tags">
            <text v-for="tag in detail.wantTags" :key="tag" class="tag tag--plain">{{ tag }}</text>
          </view>
        </view>
      </view>
    </scroll-view>

    <!-- 底部操作栏 -->
    <view v-if="detail" class="bottom-bar">
      <view class="bottom-bar__btn" hover-class="bottom-bar__btn--active" @tap="onSwap">
        <text class="bottom-bar__btn-text">发起互换</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
  import { ref } from 'vue'
  import { onLoad } from '@dcloudio/uni-app'
  import EmptyState from '@/components/empty-state.uvue'
  import { getSkillDetail } from '@/services/api/skill'
  import { formatRating, formatNumber } from '@/utils/format'
  import type { Skill } from '@/types/skill'

  const detail = ref<Skill | null>(null)
  const loading = ref(true)
  const skillId = ref(0)

  async function loadDetail() {
    try {
      loading.value = true
      detail.value = await getSkillDetail(skillId.value)
    } catch (e) {
      uni.showToast({ title: (e as Error).message || '加载失败', icon: 'none' })
    } finally {
      loading.value = false
    }
  }

  function onSwap() {
    uni.showModal({
      title: '发起互换',
      content: '将向对方发送互换请求，确认吗？',
      success: (res) => {
        if (res.confirm) {
          uni.showToast({ title: '已发送请求', icon: 'none' })
        }
      }
    })
  }

  onLoad((options) => {
    skillId.value = Number(options?.id ?? 0)
    loadDetail()
  })
</script>

<style lang="scss">
