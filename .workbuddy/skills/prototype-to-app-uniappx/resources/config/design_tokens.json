{
  "version": "1.0.0",
  "description": "默认设计 token。原型未提供明确视觉规范时，按本文件取值；原型有明确规范时以原型为准并覆盖此处。",
  "note": "生成时写入 uni.scss，页面统一引用变量，禁止在页面内写魔法数字。",
  "color": {
    "primary": "#2B6DE5",
    "primary_light": "#E8F0FE",
    "success": "#18A058",
    "warning": "#F0A020",
    "error": "#D03050",
    "text_primary": "#1F2225",
    "text_secondary": "#5C6570",
    "text_tertiary": "#9099A3",
    "border": "#E5E7EB",
    "divider": "#F0F1F3",
    "background": "#F5F6F8",
    "surface": "#FFFFFF",
    "mask": "rgba(0, 0, 0, 0.45)"
  },
  "dark_mode": {
    "enabled": false,
    "note": "需要深色模式时参考 uni-app x 的 theme.json，本技能默认只输出亮色。",
    "background": "#121417",
    "surface": "#1C1F24",
    "text_primary": "#F5F6F8",
    "text_secondary": "#A8B0BA",
    "border": "#2C3036"
  },
  "font": {
    "size": {
      "xs": "22rpx",
      "sm": "24rpx",
      "base": "28rpx",
      "md": "30rpx",
      "lg": "34rpx",
      "xl": "40rpx",
      "xxl": "48rpx"
    },
    "weight": {
      "normal": "400",
      "medium": "500",
      "bold": "600"
    },
    "line_height": {
      "tight": "1.3",
      "normal": "1.5",
      "loose": "1.8"
    }
  },
  "spacing": {
    "note": "统一使用 rpx；App 端 flex 默认竖向。",
    "xs": "8rpx",
    "sm": "16rpx",
    "md": "24rpx",
    "lg": "32rpx",
    "xl": "48rpx",
    "page_padding": "32rpx",
    "section_gap": "24rpx"
  },
  "radius": {
    "sm": "8rpx",
    "md": "16rpx",
    "lg": "24rpx",
    "pill": "999rpx",
    "circle": "50%"
  },
  "shadow": {
    "card": "0 4rpx 16rpx rgba(0, 0, 0, 0.06)",
    "float": "0 8rpx 32rpx rgba(0, 0, 0, 0.12)"
  },
  "sizing": {
    "nav_bar_height": "44px",
    "tab_bar_height": "50px",
    "avatar_sm": "64rpx",
    "avatar_md": "88rpx",
    "avatar_lg": "128rpx",
    "icon_sm": "32rpx",
    "icon_md": "40rpx",
    "button_height": "88rpx",
    "touch_target_min": "88rpx"
  },
  "animation": {
    "duration_fast": "150ms",
    "duration_base": "250ms",
    "easing": "ease-in-out"
  }
}
